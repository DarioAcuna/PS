# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/la_cupula_db?schema=public"

# Server
PORT=3000

# Auth
JWT_SECRET=tu_clave_super_segura_minimo_32_caracteres_aleatorios_xyz123_abc456_def789
JWT_EXPIRATION=24h

# Admin
PROTECTED_ADMIN_EMAIL=admin@example.com

# CORS - Para desarrollo: http://localhost:4200
# Para producción: https://tunominio.com,https://www.tunominio.com
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
# Login: máximo 5 intentos por 15 minutos (900 segundos)
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=900

# Global: máximo 100 requests por 15 minutos para endpoints normales
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_GLOBAL_TTL=900
