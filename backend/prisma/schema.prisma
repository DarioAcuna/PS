generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clase {
  id        Int        @id @default(autoincrement())
  name      String
  level     String?
  createdAt DateTime   @default(now()) @map("created_at")
  schedules Schedule[]

  @@unique([name, level])
  @@map("classes")
}

model Schedule {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  dayOfWeek   Int       @map("day_of_week")
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  maxCapacity Int       @default(20) @map("max_capacity")
  createdAt   DateTime  @default(now()) @map("created_at")

  class       Clase     @relation(fields: [classId], references: [id], onDelete: Restrict)
  sessions    Session[]

  @@map("schedules")
}

model Session {
  id           Int           @id @default(autoincrement())
  scheduleId   Int           @map("schedule_id")
  date         DateTime      @map("date")
  startTime    String        @map("start_time")
  endTime      String        @map("end_time")
  instructor   String?
  status       SessionStatus @default(SCHEDULED) @map("status")
  createdAt    DateTime     @default(now()) @map("created_at")

  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([scheduleId, date])
  @@unique([date, startTime, endTime, instructor])
  @@map("sessions")
}

model Reservation {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("reservations")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("announcements")
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  capacity    Int
  eventDate   DateTime @map("event_date")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("events")
}

enum SessionStatus {
  SCHEDULED
  MODIFIED

  @@map("session_status")
}

enum UserRole {
  ADMIN
  PROFESOR
  ALUMNO

  @@map("user_role")
}

enum UserStatus {
  ACTIVO
  INACTIVO

  @@map("user_status")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  firstName  String?    @map("first_name")
  lastName   String?    @map("last_name")
  email      String     @unique
  password   String?
  role       UserRole   @default(ALUMNO)
  belt       String?
  beltDegree Int?       @map("belt_degree")
  status     UserStatus @default(ACTIVO)
  createdAt  DateTime   @default(now()) @map("created_at")
  reservations Reservation[]

  @@map("users")
}
