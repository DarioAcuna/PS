generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clase {
  id        Int        @id @default(autoincrement())
  name      String
  level     String?
  createdAt DateTime   @default(now()) @map("created_at")
  schedules Schedule[]

  @@unique([name, level])
  @@map("classes")
}

model Schedule {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  dayOfWeek   Int       @map("day_of_week")
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  maxCapacity Int       @default(20) @map("max_capacity")
  createdAt   DateTime  @default(now()) @map("created_at")

  class       Clase     @relation(fields: [classId], references: [id], onDelete: Restrict)
  sessions    Session[]

  @@map("schedules")
}

model Session {
  id           Int           @id @default(autoincrement())
  scheduleId   Int           @map("schedule_id")
  date         DateTime      @map("date")
  startTime    String        @map("start_time")
  endTime      String        @map("end_time")
  instructor   String?
  status       SessionStatus @default(SCHEDULED) @map("status")
  createdAt    DateTime     @default(now()) @map("created_at")

  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, date])
  @@unique([date, startTime, endTime, instructor])
  @@map("sessions")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("announcements")
}

enum SessionStatus {
  SCHEDULED
  MODIFIED

  @@map("session_status")
}

enum UserRole {
  ADMIN
  PROFESOR
  ALUMNO

  @@map("user_role")
}

enum UserStatus {
  ACTIVO
  INACTIVO

  @@map("user_status")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  firstName  String?    @map("first_name")
  lastName   String?    @map("last_name")
  email      String     @unique
  password   String?
  role       UserRole   @default(ALUMNO)
  belt       String?
  beltDegree Int?       @map("belt_degree")
  status     UserStatus @default(ACTIVO)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("users")
}

enum MemberType {
  ALUMNO
  PROFESOR

  @@map("member_type")
}

enum MemberStatus {
  ACTIVO
  INACTIVO

  @@map("member_status")
}

model Member {
  id          Int          @id @default(autoincrement())
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  email       String       @unique
  belt        String
  beltDegree  Int          @default(0) @map("belt_degree")
  memberType  MemberType   @default(ALUMNO) @map("member_type")
  status      MemberStatus @default(ACTIVO)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("members")
}

