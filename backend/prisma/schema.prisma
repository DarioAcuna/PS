generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clase {
  id        Int        @id @default(autoincrement())
  name      String
  level     String?
  createdAt DateTime   @default(now()) @map("created_at")
  schedules Schedule[]

  @@unique([name, level])
  @@map("classes")
}

model Schedule {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  dayOfWeek   Int       @map("day_of_week")
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  maxCapacity Int       @default(20) @map("max_capacity")
  createdAt   DateTime  @default(now()) @map("created_at")

  class       Clase     @relation(fields: [classId], references: [id], onDelete: Restrict)
  sessions    Session[]

  @@map("schedules")
}

model Session {
  id           Int           @id @default(autoincrement())
  scheduleId   Int           @map("schedule_id")
  date         DateTime      @map("date")
  startTime    String        @map("start_time")
  endTime      String        @map("end_time")
  instructor   String?
  status       SessionStatus @default(SCHEDULED) @map("status")
  createdAt    DateTime     @default(now()) @map("created_at")

  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, date])
  @@unique([date, startTime, endTime, instructor])
  @@map("sessions")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("announcements")
}

enum SessionStatus {
  SCHEDULED
  MODIFIED

  @@map("session_status")
}

enum UserRole {
  ADMIN
  PROFESOR
  ALUMNO

  @@map("user_role")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      UserRole  @default(ALUMNO)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("users")
}

